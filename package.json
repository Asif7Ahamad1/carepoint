{
  "name": "carepoint-clinic-booking",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/api"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev --workspace @carepoint/api",
    "dev:web": "npm run dev --workspace @carepoint/web",
    "build": "npm run build --workspace @carepoint/api && npm run build --workspace @carepoint/web",
    "test": "npm run test --workspace @carepoint/api",
    "test:concurrency": "node scripts/concurrency-harness.mjs",
    "seed:sql": "node scripts/generate-seed.mjs",
    "mysql:setup-script": "npm run seed:sql && node scripts/generate-workbench-setup.mjs",
    "start": "npm run start --workspace @carepoint/api"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
